<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CfTunnelTool</AssemblyName>
    <RootNamespace>CfTunnelTool</RootNamespace>
    <Product>CfTunnelTool</Product>
    <AssemblyTitle>CfTunnelTool</AssemblyTitle>
    <Version>1.11.0</Version>

    <!-- 發行商資訊：顯示在檔案內容、工作管理員與「設定 → 應用程式」 -->
    <Company>鴻森智能科技 HONGSEN Intelligent Technology Co.,Ltd.</Company>
    <Authors>HONGSEN Intelligent Technology Co.,Ltd.</Authors>
    <Copyright>Copyright © 2026 鴻森智能科技 HONGSEN Intelligent Technology Co.,Ltd.</Copyright>
    <Description>CfTunnelTool － 透過 Cloudflare Tunnel 讓外網連到網站、API 與遠端桌面</Description>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Microsoft JhengHei UI, 10pt</ApplicationDefaultFont>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 正式版：啟動時自動要求系統管理員權限（UAC） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

  <!-- manifest 不是合法 XML 時（例如註解裡出現兩個連續減號），Windows 會拒絕啟動程式；建置時先檢查 -->
  <Target Name="ValidateAppManifest" BeforeTargets="BeforeBuild">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\app.manifest" Query="/*/@manifestVersion">
      <Output TaskParameter="Result" ItemName="_ManifestVersion" />
    </XmlPeek>
    <Error Condition="'@(_ManifestVersion)' == ''" Text="app.manifest 缺少 manifestVersion，請檢查格式。" />
  </Target>

</Project>
